meta {
  name: Update family member
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/customer/family/{{familyMemberId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "displayName": "Lakshmi",
    "conditions": ["diabetes", "high_bp"]
  }
}

tests {
  test("a customer updates a family member", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    if (!bru.getEnvVar("familyMemberId")) {
      expect(res.getStatus()).to.be.oneOf([400, 404]);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.member.displayName).to.equal("Lakshmi");
  });
}

docs {
  Omitted fields stay as they are. The account holder stays relation self.
}
