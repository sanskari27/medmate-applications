meta {
  name: Create family member
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/customer/family
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "displayName": "Amma",
    "relation": "mother",
    "ageYears": 62,
    "conditions": ["diabetes"],
    "allergies": ["penicillin"],
    "mobile": "9845012345",
    "consent": true
  }
}

tests {
  test("a customer adds a family member with permission", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(201);
    expect(res.body.member.displayName).to.equal("Amma");
    bru.setEnvVar("familyMemberId", res.body.member.id);
  });
}

docs {
  Relation cannot be self. Age or birthday is required, and consent must be true.
}
