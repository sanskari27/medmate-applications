meta {
  name: Read family member
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/customer/family/{{familyMemberId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer reads one family member", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    if (!bru.getEnvVar("familyMemberId")) {
      expect(res.getStatus()).to.be.oneOf([400, 404]);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.member.id).to.equal(bru.getEnvVar("familyMemberId"));
  });
}

docs {
  Another account's member is not found.
}
