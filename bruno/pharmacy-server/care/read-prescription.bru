meta {
  name: Read prescription
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/customer/prescriptions/{{prescriptionId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer reads one prescription", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    if (!bru.getEnvVar("prescriptionId")) {
      expect(res.getStatus()).to.be.oneOf([400, 404]);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.prescription.lines).to.be.an("array");
    const line = res.body.prescription.lines.find((item) => !item.scheduled);
    if (line) {
      bru.setEnvVar("prescriptionLineId", line.id);
    }
  });
}

docs {
  Each line says whether it is already on a schedule and whether the catalogue product requires a prescription.
}
