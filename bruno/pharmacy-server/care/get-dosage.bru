meta {
  name: Get dosage
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/customer/dosage
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer reads this week's dosage board", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.week).to.be.an("array");
    const dose = (res.body.groups || []).flatMap((group) => group.doses || [])[0];
    if (dose) {
      bru.setEnvVar("doseId", dose.id);
    }
  });
}

docs {
  Optional memberId and date. Date must be one of the last seven days in Asia/Kolkata. Omit memberId for everyone.
}
