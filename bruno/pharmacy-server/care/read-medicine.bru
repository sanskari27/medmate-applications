meta {
  name: Read medicine
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/customer/medicines/{{medicineId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer reads one scheduled medicine", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    if (!bru.getEnvVar("medicineId")) {
      expect(res.getStatus()).to.be.oneOf([400, 404]);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.medicine.id).to.equal(bru.getEnvVar("medicineId"));
  });
}

docs {
  Includes the computed days of supply.
}
