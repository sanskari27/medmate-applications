meta {
  name: List addresses
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customer/addresses
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer sees only their delivery addresses", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.addresses).to.be.an("array");
  });
}

docs {
  Customer accounts only. A pharmacy token is forbidden. Newest updated time first.
}
