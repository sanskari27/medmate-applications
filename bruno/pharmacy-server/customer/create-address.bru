meta {
  name: Create address
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/customer/addresses
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "label": "home",
    "line1": "Flat 302, Sri Sai Residency",
    "line2": "7th Cross, Jayanagar 4th Block",
    "landmark": "Near Cool Joint",
    "city": "Bengaluru",
    "pincode": "560011",
    "latitude": 12.9716,
    "longitude": 77.5946,
    "receiverName": "Priya Sharma",
    "receiverPhone": "9845012345",
    "callOnArrival": true,
    "riderNote": "Ring twice",
    "selected": true
  }
}

tests {
  test("a customer saves a Bengaluru delivery address", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.be.oneOf([201, 409]);
    if (res.getStatus() === 201) {
      expect(res.body.address.label).to.equal("home");
      expect(res.body.address.pincode).to.equal("560011");
      expect(res.body.address.latitude).to.equal(12.9716);
      expect(res.body.address.longitude).to.equal(77.5946);
      expect(res.body.address.receiverPhone).to.equal("+919845012345");
      expect(res.body.address.selected).to.equal(true);
      bru.setEnvVar("customerAddressId", res.body.address.id);
    }
  });
}

docs {
  Pincodes must start with 560. Latitude and longitude are required. At most one selected address, and at most ten saved addresses.
}
