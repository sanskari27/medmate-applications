meta {
  name: List available catalog
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/customer/catalog?category=Pain&q=crocin&page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer lists in-stock catalog products", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body).to.have.property("total");
    if (res.body.items.length > 0) {
      bru.setEnvVar("catalogProductId", res.body.items[0].productId);
    }
  });
}

docs {
  Customer accounts only. A product is included when some pharmacy has a positive, unexpired batch.
  category and q are optional. Items with an image are listed before items without one, then by name.
  Each item has productId, name, displayName, price, image, rxRequired, marketerName, pack,
  productForm, and composition. composition is the ingredient list for a drug and null for other products.
  image, marketerName, pack, and productForm are null when the catalog has no value.
  price is the national catalog MRP. When the selected address has an approved pharmacy within 40 km
  that accepts online orders and has set an online price, the item also has pharmacyId, pharmacyName,
  distanceKm, onlineMrp, onlinePrice, and deliveryCharge. deliveryCharge.amount is 0.00 at 3 km or
  nearer and 20.00 beyond that. Those fields are null when no listing is in range.
  The first productId is stored as catalogProductId for Read catalog product.
}
