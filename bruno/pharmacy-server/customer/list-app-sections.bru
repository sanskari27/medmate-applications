meta {
  name: List app sections
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/customer/app-sections
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer lists category tiles", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.sections).to.be.an("array");
  });
}

docs {
  Customer accounts only. Tiles are ordered by position, then category. Each tile has a category and a square image.
}
