meta {
  name: Nearby pharmacies
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/customer/pharmacies/nearby?latitude=12.9716&longitude=77.5946&limit=20
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer sees approved pharmacies nearest first", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.pharmacies).to.be.an("array");
    res.body.pharmacies.forEach(function(pharmacy) {
      expect(pharmacy.openingHours).to.be.an("array");
      expect(pharmacy.closed).to.be.a("boolean");
      if (pharmacy.closed) {
        expect(pharmacy.closesOn).to.equal(null);
      } else {
        expect(pharmacy.closesOn).to.match(/^\d{2}:\d{2}$/);
      }
    });
  });
}

docs {
  Customer accounts only. A pharmacy token is forbidden.
  Approved pharmacies that have a pin and are within 40 km, nearest first.
  Each pharmacy includes openingHours. An unset week is an empty array.
  Each pharmacy also includes closed and closesOn for the current time in Asia/Kolkata.
  closed is true when today is marked closed, hours are unset, or the request falls outside today's opening windows.
  Inside a window, closed is false and closesOn is that window's close time (HH:mm). At the close time the pharmacy is closed.
  The list is not filtered by whether the pharmacy is open now.
  Each pharmacy includes licenceNumber (drug licence) and pharmacistName.
  Limit defaults to 20 and caps at 50.
}
