meta {
  name: Nearby pharmacies
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/customer/pharmacies/nearby?latitude=12.9716&longitude=77.5946&limit=20
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a customer sees approved pharmacies nearest first", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.pharmacies).to.be.an("array");
  });
}

docs {
  Customer accounts only. A pharmacy token is forbidden.
  Approved pharmacies that have a pin and are within 40 km, nearest first.
  Limit defaults to 20 and caps at 50.
}
