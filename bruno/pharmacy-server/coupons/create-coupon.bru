meta {
  name: Create coupon
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/coupons
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:multipart-form {
  coupon: {"code":"WELCOME10","title":"Welcome offer","discountType":"pct","discountValue":10,"maxDiscount":"50.00","minOrder":"200.00","maxRedemptions":100,"maxPerCustomer":1,"pharmacyScope":"all","active":true}
  banner: @file(banner.png)
}

tests {
  test("admin and sales can create a coupon", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(201);
    expect(res.body.coupon.code).to.equal("WELCOME10");
    expect(res.body.coupon.banner.contentType).to.equal("image/png");
  });
}

docs {
  Multipart request. The coupon part is JSON and the banner part is a JPEG, PNG, or WebP up to 2 MB.
  Blank limits mean unlimited. A percent coupon may set maxDiscount. pharmacyScope selected needs pharmacyIds.
}
