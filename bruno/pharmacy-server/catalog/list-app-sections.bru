meta {
  name: List app sections
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/app-sections
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("a platform admin or sales staff lists app sections", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.sections).to.be.an("array");
  });
}

docs {
  Platform admin or sales staff. Returns every mobile section, ordered by position. Each section has an image, a banner, and its categories.
}
