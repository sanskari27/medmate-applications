meta {
  name: Create app section
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/app-sections
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:multipart-form {
  section: {"title":"Everyday care","position":1,"categories":[{"category":"Pain","images":[{"file":true}]}]}
  image: @file(../coupons/banner.png)
  banner: @file(../coupons/banner.png)
  categoryImage: @file(../coupons/banner.png)
}

tests {
  test("admin and sales can create a section", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      expect(res.body.detail).to.equal("Sign in is required");
      return;
    }
    if (res.getStatus() === 403) {
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    if (res.getStatus() === 400) {
      expect(res.body.detail).to.be.a("string");
      return;
    }
    expect(res.getStatus()).to.equal(201);
    expect(res.body.section.title).to.be.a("string");
    expect(res.body.section.image.contentType).to.be.a("string");
    expect(res.body.section.banner.contentType).to.be.a("string");
    expect(res.body.section.categories).to.be.an("array");
  });
}

docs {
  Multipart request. The section part is JSON. image, banner, and each new categoryImage are JPEG, PNG, or WebP files up to 2 MB.
  A category must already exist on a drug or FMCG product. Each category can be listed in only one section.
  Category image order follows the images array: {"id":"<existing>"} keeps a file, {"file":true} uses the next categoryImage part.
}
